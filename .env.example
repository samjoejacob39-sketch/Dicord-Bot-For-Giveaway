DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Bot Permissions
BOT_OWNER_ID=
ADMIN_IDS=

# Anti-Spam AI Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_ENABLED=true

# Database Path
DATABASE_PATH=./data/antispam.sqlite

# Anti-Spam Thresholds
WARNING_THRESHOLD=45
TIMEOUT_THRESHOLD=65
SEVERE_TIMEOUT_THRESHOLD=80
EXTREME_THRESHOLD=95

DEFAULT_TIMEOUT_MINUTES=60
SEVERE_TIMEOUT_MINUTES=240
EXTREME_TIMEOUT_MINUTES=1440

AI_MAX_REQUESTS_PER_GUILD_PER_MINUTE=10
AI_MAX_REQUESTS_PER_USER_PER_MINUTE=2

WARNING_COOLDOWN_SECONDS=30

LOG_LEVEL=info
